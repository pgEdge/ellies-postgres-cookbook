#!/usr/bin/env bash
#
# Checks the shape of the output of the metrics example. The values vary from
# run to run, and the top queries depend on whether the monitored server has
# the pg_stat_statements extension, so this checks only the format of each
# line.
set -uo pipefail

out="$(cat)"

fail() { echo "check_output: $1" >&2; exit 1; }

# The two metric lines come first, and each has at least one point.
grep -qE '^numbackends: [1-9][0-9]* points, latest -?[0-9.]+$' <<<"$out" ||
    fail "missing or malformed numbackends line"
grep -qE '^xact_commit: [1-9][0-9]* points, latest -?[0-9.]+$' <<<"$out" ||
    fail "missing or malformed xact_commit line"

# Either the extension is missing, or there is a heading and ranked lines.
if grep -q '^No statements recorded' <<<"$out"; then
    exit 0
fi
grep -qx 'Top queries by total execution time:' <<<"$out" ||
    fail "missing the top queries heading"
grep -qE '^1\. [0-9]+ calls, [0-9.]+ ms mean: .+$' <<<"$out" ||
    fail "missing or malformed first query line"
if grep -vE '^(numbackends|xact_commit): |^Top queries |^[1-5]\. [0-9]+ calls, [0-9.]+ ms mean: ' <<<"$out" | grep -q .; then
    fail "unexpected line in the output"
fi
