#!/usr/bin/env bash
#
# Checks the shape of the output of the chat example. The model's wording
# changes from run to run, so this checks only that each line is present and
# that the replies are not blank.
set -uo pipefail

out="$(cat)"

fail() { echo "check_output: $1" >&2; exit 1; }

grep -qx 'Provider: [a-z]* (model .*)' <<<"$out" ||
    fail "missing or malformed provider line"
grep -qE '^Reply: .*[^[:space:]]' <<<"$out" ||
    fail "missing or blank reply"
grep -qE '^Follow-up reply: .*[^[:space:]]' <<<"$out" ||
    fail "missing or blank follow-up reply"
grep -qx 'Stop reason: [a-z_]*' <<<"$out" ||
    fail "missing or malformed stop reason"
