#!/usr/bin/env bash
#
# Checks the shape of the structured_extraction output, which varies from
# run to run (for example in the capitalisation of item names): one
# "Customer: <name> <<email>>" line followed by at least one
# "Item: <quantity> x <description> @ <price>" line, and nothing else.
# Fails on empty or blank output and on error text.
#
# Copyright (c) 2026, pgEdge, Inc.
# This code is released under the PostgreSQL License.

set -uo pipefail

output="$(cat)"

if [[ -z "${output//[[:space:]]/}" ]]; then
    echo "check_output: the program printed nothing" >&2
    exit 1
fi

customer_re='^Customer: .+ <[^<>@[:space:]]+@[^<>@[:space:]]+>$'
item_re='^Item: [1-9][0-9]* x .*[^[:space:]].* @ [0-9]+\.[0-9]{2}$'

line_number=0
items=0
while IFS= read -r line; do
    line_number=$((line_number + 1))
    if [[ $line_number -eq 1 ]]; then
        if [[ ! "$line" =~ $customer_re ]]; then
            echo "check_output: unexpected first line: $line" >&2
            exit 1
        fi
    elif [[ "$line" =~ $item_re ]]; then
        items=$((items + 1))
    else
        echo "check_output: unexpected line $line_number: $line" >&2
        exit 1
    fi
done <<<"$output"

if [[ $items -lt 1 ]]; then
    echo "check_output: no item lines" >&2
    exit 1
fi
